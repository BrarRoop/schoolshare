@{
    ViewData["Title"] = "Home Page";
}

    <section class="intro">
        <div class="intro-text">
            <h1>Empowering Education Through Sharing</h1>
            <p>Join the movement of sustainable resource exchange in your school.</p>
            <a href="/register" class="cta-button">Join Us Now</a>
        </div>
        <div class="intro-img">
            <img src="images/school sharing.jpg" alt="Sharing Concept">
        </div>
    </section>

    <section class="how-it-works">
        <h2>How It Works</h2>
        <div class="step">
        <img src="images/catalog3.jpeg" width="50%" height="50%"  alt="Browse Catalogue">
            <h3>Browse Catalogue</h3>
            <p>Explore the vast range of items offered by peers.</p>
        </div>
        <div class="step">
        <img src="images/send request.png" width="50%" height="50%" alt="Request Item">
            <h3>Request Item</h3>
            <p>Find something you need? Request it with a click.</p>
        </div>
        <div class="step">
            <img src="images/share.JPG" width="50%" height="50%" alt="Share Your Own">
            <h3>Share Your Own</h3>
            <p>Contribute to the community by listing items you can share.</p>
        </div>
    </section>

    <section class="testimonials">
        <h2>What Our Users Say</h2>
        <div class="testimonial">
            <blockquote>
                "SchoolShare has made it so easy to find textbooks for the semester without spending a fortune. Love this platform!"
            </blockquote>
            <p class="user">- Jamie L., Economics Major</p>
        </div>
        <div class="testimonial">
            <blockquote>
                "I've met more classmates through SchoolShare than any other campus event. It's more than just sharing resources."
            </blockquote>
            <p class="user">- Alex G., Computer Science Club President</p>
        </div>
    </section>

    