@model IEnumerable<SchoolShare.Models.Notification>

@{
    ViewData["Title"] = "Index";
    bool isAuthenticated = User.Identity.IsAuthenticated;
}

<h1>Index</h1>

<p>
    @if(isAuthenticated){
        <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Recipient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Message)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsRead)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Recipient.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Message)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsRead)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
                @if (isAuthenticated)
                {
            <td>
                <a asp-action="Edit" asp-route-id="@item.NotificationID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.NotificationID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.NotificationID">Delete</a>
            </td>
                }
        </tr>
}
    </tbody>
</table>
